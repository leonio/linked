<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Guit.App.Views.PullFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Guit.Core.Models"
    xmlns:xaml="using:Guit.App.Xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="16,16,24,8" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          VerticalAlignment="Top"
          AutomationProperties.Name="Back"
          Command="{x:Bind ViewModel.GoBackCommand}"
          ToolTipService.ToolTip="Back (Alt+Left or Esc)">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Left" Modifiers="Menu" />
          <KeyboardAccelerator Key="Escape" />
        </Button.KeyboardAccelerators>
        <FontIcon FontSize="16" Glyph="&#xE72B;" />
      </Button>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Files changed" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
      </StackPanel>
      <Button
          Grid.Column="2"
          VerticalAlignment="Top"
          AutomationProperties.Name="Open on GitHub"
          Command="{x:Bind ViewModel.OpenInBrowserCommand}"
          ToolTipService.ToolTip="Open on GitHub">
        <FontIcon FontSize="16" Glyph="&#xE8A7;" />
      </Button>
    </Grid>

    <!-- Every file and every diff line is one row of this list, so a 5,000-line diff still only creates what is on screen. -->
    <ListView
        Grid.Row="1"
        Padding="12,0,12,12"
        ContainerContentChanging="OnContainerContentChanging"
        ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
        SelectionMode="None">
      <ListView.ItemContainerStyle>
        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="0" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:DiffRow">
          <Grid
              Margin="{x:Bind xaml:Bind.DiffMargin(Kind)}"
              Padding="8,2"
              Background="{x:Bind xaml:Bind.DiffBackground(Kind)}"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                HorizontalAlignment="Right"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind OldNumber}" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind NewNumber}" />
            <TextBlock
                Grid.Column="2"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                FontWeight="{x:Bind xaml:Bind.DiffWeight(Kind)}"
                IsTextSelectionEnabled="True"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Column="3"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Detail}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <ProgressBar
        Grid.Row="1"
        VerticalAlignment="Bottom"
        IsIndeterminate="True"
        Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />

    <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    <TextBlock
        Grid.Row="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Style="{StaticResource SubtitleTextBlockStyle}"
        Text="No files changed"
        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

    <InfoBar
        Grid.Row="1"
        Margin="24,0"
        VerticalAlignment="Top"
        IsClosable="False"
        IsOpen="{x:Bind xaml:Bind.IsNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Error" />
  </Grid>
</Page>
