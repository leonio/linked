<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Guit.App.Views.JobLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Guit.App.Xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="16,16,24,8" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          VerticalAlignment="Top"
          AutomationProperties.Name="Back"
          Command="{x:Bind ViewModel.GoBackCommand}"
          ToolTipService.ToolTip="Back (Alt+Left or Esc)">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Left" Modifiers="Menu" />
          <KeyboardAccelerator Key="Escape" />
        </Button.KeyboardAccelerators>
        <FontIcon FontSize="16" Glyph="&#xE72B;" />
      </Button>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
      </StackPanel>
      <Button
          Grid.Column="2"
          VerticalAlignment="Top"
          AutomationProperties.Name="Refresh"
          Command="{x:Bind ViewModel.ReloadCommand}"
          ToolTipService.ToolTip="Refresh (F5)">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="F5" />
        </Button.KeyboardAccelerators>
        <FontIcon FontSize="16" Glyph="&#xE72C;" />
      </Button>
    </Grid>

    <InfoBar
        Grid.Row="1"
        Margin="24,0,24,8"
        IsClosable="False"
        IsOpen="{x:Bind xaml:Bind.IsNotEmpty(ViewModel.Notice), Mode=OneWay}"
        Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
        Severity="Informational" />

    <!-- One row per log line, so even a 5,000-line log only creates what is on screen. -->
    <ListView
        x:Name="List"
        Grid.Row="2"
        Padding="12,0,12,12"
        ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
        SelectionMode="None">
      <ListView.ItemContainerStyle>
        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="12,1" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock
              FontFamily="Cascadia Mono, Consolas"
              FontSize="12"
              IsTextSelectionEnabled="True"
              Text="{x:Bind}"
              TextWrapping="Wrap" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    <InfoBar
        Grid.Row="2"
        Margin="24,0"
        VerticalAlignment="Top"
        IsClosable="False"
        IsOpen="{x:Bind xaml:Bind.IsNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Warning" />
  </Grid>
</Page>
