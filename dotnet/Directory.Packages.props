<Project>
  <!-- Central package management. Add a version here, reference without Version in the csproj.
       Adding a package needs a reason: see .claude/skills/dependencies/SKILL.md -->
  <ItemGroup Label="API client">
    <PackageVersion Include="Refit" Version="16.4.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="MVVM and UI">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="TUnit" Version="1.81.16" />
    <PackageVersion Include="Refit.Testing" Version="16.4.0" />
  </ItemGroup>
</Project>
