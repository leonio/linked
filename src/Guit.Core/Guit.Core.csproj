<Project Sdk="Microsoft.NET.Sdk">
  <!-- View models and app services. No XAML types.
       net10.0            : so the tests run on any OS.
       net10.0-windows... : so the CsWinRT generator sees every type that crosses into WinUI
                            (collections bound to ItemsSource, INotifyPropertyChanged objects). -->
  <PropertyGroup>
    <TargetFrameworks>$(GuitNetVersion);$(GuitWindowsTfm)</TargetFrameworks>
    <TargetPlatformMinVersion Condition="'$(TargetFramework)' == '$(GuitWindowsTfm)'">$(GuitWindowsMinVersion)</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Guit.Api\Guit.Api.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
