<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Guit.App.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Guit.App.Views"
    xmlns:xaml="using:Guit.App.Xaml">
  <Grid>
    <!-- Exactly one of the two elements below exists at a time (x:Load). -->
    <views:SignInView x:Name="SignIn" x:Load="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}" />

    <NavigationView
        x:Name="Navigation"
        x:Load="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        Loaded="OnNavigationLoaded"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Inbox" Icon="Mail" Tag="inbox" />
        <NavigationViewItem Content="Pull requests" Icon="Switch" Tag="pulls" />
        <NavigationViewItem Content="Actions" Icon="Play" Tag="runs" />
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="{x:Bind ViewModel.Login, Mode=OneWay}" SelectsOnInvoked="False">
          <NavigationViewItem.Icon>
            <ImageIcon Source="{x:Bind xaml:Bind.Image(ViewModel.AvatarUrl, 20), Mode=OneWay}" />
          </NavigationViewItem.Icon>
          <NavigationViewItem.ContextFlyout>
            <MenuFlyout>
              <MenuFlyoutItem Command="{x:Bind ViewModel.SignOutCommand}" Text="Sign out" />
            </MenuFlyout>
          </NavigationViewItem.ContextFlyout>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</UserControl>
