<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Guit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Guit.App.Xaml">
  <ScrollViewer>
    <StackPanel
        MaxWidth="720"
        Margin="24,16,24,24"
        HorizontalAlignment="Left"
        Spacing="24">
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

      <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Appearance" />
        <!-- Item order must match the AppTheme enum values. -->
        <RadioButtons Header="Theme" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
          <RadioButton Content="Use Windows setting" />
          <RadioButton Content="Light" />
          <RadioButton Content="Dark" />
        </RadioButtons>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Account" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image
              Width="32"
              Height="32"
              Source="{x:Bind xaml:Bind.Image(ViewModel.Shell.AvatarUrl, 32), Mode=OneWay}" />
          <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Shell.Login, Mode=OneWay}" />
          <Button Command="{x:Bind ViewModel.SignOutCommand}" Content="Sign out" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
          <Run Text="Guit" />
          <Run Text="{x:Bind ViewModel.Version}" />
        </TextBlock>
        <HyperlinkButton
            Padding="0"
            Command="{x:Bind ViewModel.OpenProjectCommand}"
            Content="Project on GitHub" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
