<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Guit.App.Views.ConversationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Guit.Core.Models"
    xmlns:xaml="using:Guit.App.Xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="16,16,24,8" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          VerticalAlignment="Top"
          AutomationProperties.Name="Back"
          Command="{x:Bind ViewModel.GoBackCommand}"
          ToolTipService.ToolTip="Back (Alt+Left)">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Left" Modifiers="Menu" />
        </Button.KeyboardAccelerators>
        <FontIcon FontSize="16" Glyph="&#xE72B;" />
      </Button>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock
            MaxLines="2"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
          <Run Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
          <Run Text="·" />
          <Run Text="{x:Bind ViewModel.State, Mode=OneWay}" />
        </TextBlock>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Visibility="{x:Bind ViewModel.HasPullDetails, Mode=OneWay}">
          <Run Text="{x:Bind ViewModel.Branches, Mode=OneWay}" />
          <Run Text="·" />
          <Run Text="{x:Bind ViewModel.DiffSummary, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <StackPanel
          Grid.Column="2"
          VerticalAlignment="Top"
          Orientation="Horizontal"
          Spacing="8">
        <Button
            Command="{x:Bind ViewModel.ShowFilesCommand}"
            Content="Files changed"
            Visibility="{x:Bind ViewModel.IsPullRequest, Mode=OneWay}" />
        <Button
            AutomationProperties.Name="Open on GitHub"
            Command="{x:Bind ViewModel.OpenInBrowserCommand}"
            ToolTipService.ToolTip="Open on GitHub">
          <FontIcon FontSize="16" Glyph="&#xE8A7;" />
        </Button>
      </StackPanel>
    </Grid>

    <ListView
        x:Name="List"
        Grid.Row="1"
        Padding="12,0,12,12"
        ContainerContentChanging="OnContainerContentChanging"
        ItemsSource="{x:Bind ViewModel.Comments}"
        SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:CommentItem">
          <Grid
              Margin="0,4"
              Padding="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              ColumnSpacing="8"
              CornerRadius="{ThemeResource ControlCornerRadius}"
              RowSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image
                Width="24"
                Height="24"
                x:Phase="1"
                Source="{x:Bind xaml:Bind.Image(AvatarUrl, 24)}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Author}" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Association}" />
            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Posted}" />
            <RichTextBlock
                Grid.Row="1"
                Grid.ColumnSpan="4"
                xaml:Rich.Document="{x:Bind Content}"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Orientation="Horizontal"
                Spacing="8">
              <Button
                  Padding="6,2"
                  AutomationProperties.Name="Add reaction"
                  ToolTipService.ToolTip="Add reaction">
                <FontIcon FontSize="14" Glyph="&#xE76E;" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Click="OnReactClick" CommandParameter="{x:Bind}" Tag="+1" Text="&#x1F44D; Thumbs up" />
                    <MenuFlyoutItem Click="OnReactClick" CommandParameter="{x:Bind}" Tag="-1" Text="&#x1F44E; Thumbs down" />
                    <MenuFlyoutItem Click="OnReactClick" CommandParameter="{x:Bind}" Tag="laugh" Text="&#x1F604; Laugh" />
                    <MenuFlyoutItem Click="OnReactClick" CommandParameter="{x:Bind}" Tag="hooray" Text="&#x1F389; Hooray" />
                    <MenuFlyoutItem Click="OnReactClick" CommandParameter="{x:Bind}" Tag="confused" Text="&#x1F615; Confused" />
                    <MenuFlyoutItem Click="OnReactClick" CommandParameter="{x:Bind}" Tag="heart" Text="&#x2764;&#xFE0F; Heart" />
                    <MenuFlyoutItem Click="OnReactClick" CommandParameter="{x:Bind}" Tag="rocket" Text="&#x1F680; Rocket" />
                    <MenuFlyoutItem Click="OnReactClick" CommandParameter="{x:Bind}" Tag="eyes" Text="&#x1F440; Eyes" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <TextBlock
                  VerticalAlignment="Center"
                  Text="{x:Bind ReactionSummary, Mode=OneWay}"
                  Visibility="{x:Bind HasReactions, Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <ProgressBar
        Grid.Row="1"
        VerticalAlignment="Bottom"
        IsIndeterminate="True"
        Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />

    <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    <InfoBar
        Grid.Row="1"
        Margin="24,0"
        VerticalAlignment="Top"
        IsClosable="False"
        IsOpen="{x:Bind xaml:Bind.IsNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Error" />

    <Grid
        Grid.Row="2"
        Margin="24,8,24,16"
        ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox
          MaxHeight="160"
          AcceptsReturn="True"
          PlaceholderText="Write a comment"
          Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          TextWrapping="Wrap" />
      <Button
          Grid.Column="1"
          VerticalAlignment="Bottom"
          Command="{x:Bind ViewModel.SendCommand}"
          Content="Comment"
          Style="{StaticResource AccentButtonStyle}"
          ToolTipService.ToolTip="Comment (Ctrl+Enter)">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Enter" Modifiers="Control" />
        </Button.KeyboardAccelerators>
      </Button>
    </Grid>
  </Grid>
</Page>
