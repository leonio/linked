<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Guit.App.Views.PullRequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Guit.Core.Models"
    xmlns:xaml="using:Guit.App.Xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="24,16,24,8" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Pull requests" />
      <!-- Item order must match the PullRequestScope enum values. -->
      <SelectorBar
          Grid.Column="1"
          VerticalAlignment="Bottom"
          SelectionChanged="OnScopeSelectionChanged">
        <SelectorBarItem IsSelected="True" Text="Review requested" />
        <SelectorBarItem Text="Created" />
        <SelectorBarItem Text="Assigned" />
      </SelectorBar>
      <Button
          Grid.Column="2"
          VerticalAlignment="Center"
          AutomationProperties.Name="Refresh"
          Command="{x:Bind ViewModel.LoadCommand}"
          ToolTipService.ToolTip="Refresh (F5)">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="F5" />
        </Button.KeyboardAccelerators>
        <FontIcon FontSize="16" Glyph="&#xE72C;" />
      </Button>
    </Grid>

    <ListView
        Grid.Row="1"
        Padding="12,0,12,12"
        ContainerContentChanging="OnContainerContentChanging"
        IsItemClickEnabled="True"
        ItemClick="OnItemClick"
        ItemsSource="{x:Bind ViewModel.Items}"
        SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:PullRequestItem">
          <Grid Height="56" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="{x:Bind Glyph}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock
                  Style="{StaticResource BodyStrongTextBlockStyle}"
                  Text="{x:Bind Title}"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="NoWrap" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="NoWrap">
                <Run Text="{x:Bind Reference}" />
                <Run Text="·" />
                <Run Text="{x:Bind Author}" />
              </TextBlock>
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Updated}" />
            <Image
                Grid.Column="3"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                x:Phase="1"
                Source="{x:Bind xaml:Bind.Image(AvatarUrl, 20)}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <ProgressBar
        Grid.Row="1"
        VerticalAlignment="Bottom"
        IsIndeterminate="True"
        Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />

    <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    <TextBlock
        Grid.Row="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Style="{StaticResource SubtitleTextBlockStyle}"
        Text="No open pull requests here"
        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

    <InfoBar
        Grid.Row="1"
        Margin="24,0"
        VerticalAlignment="Top"
        IsClosable="False"
        IsOpen="{x:Bind xaml:Bind.IsNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Error" />
  </Grid>
</Page>
