<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Guit.App.Views.RunDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Guit.Core.Models"
    xmlns:xaml="using:Guit.App.Xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="16,16,24,8" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          VerticalAlignment="Top"
          AutomationProperties.Name="Back"
          Command="{x:Bind ViewModel.GoBackCommand}"
          ToolTipService.ToolTip="Back (Alt+Left)">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="Left" Modifiers="Menu" />
        </Button.KeyboardAccelerators>
        <FontIcon FontSize="16" Glyph="&#xE72B;" />
      </Button>
      <FontIcon
          Grid.Column="1"
          Margin="0,6,0,0"
          VerticalAlignment="Top"
          AutomationProperties.Name="{x:Bind ViewModel.StatusKind, Mode=OneWay}"
          FontSize="20"
          Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind ViewModel.StatusKind, Mode=OneWay}" />
      <StackPanel Grid.Column="2" Spacing="2">
        <TextBlock
            MaxLines="2"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
      </StackPanel>
      <StackPanel
          Grid.Column="3"
          VerticalAlignment="Top"
          Orientation="Horizontal"
          Spacing="8">
        <Button Command="{x:Bind ViewModel.RerunCommand}" Content="Re-run all jobs" />
        <Button
            AutomationProperties.Name="Refresh"
            Command="{x:Bind ViewModel.ReloadCommand}"
            ToolTipService.ToolTip="Refresh (F5)">
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" />
          </Button.KeyboardAccelerators>
          <FontIcon FontSize="16" Glyph="&#xE72C;" />
        </Button>
        <Button
            AutomationProperties.Name="Open on GitHub"
            Command="{x:Bind ViewModel.OpenInBrowserCommand}"
            ToolTipService.ToolTip="Open on GitHub">
          <FontIcon FontSize="16" Glyph="&#xE8A7;" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Clicking a job opens its log on github.com. -->
    <ListView
        Grid.Row="1"
        Padding="12,0,12,12"
        IsItemClickEnabled="True"
        ItemClick="OnItemClick"
        ItemsSource="{x:Bind ViewModel.Jobs}"
        SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:JobItem">
          <Grid Height="44" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind StatusKind}"
                FontSize="16"
                Glyph="{x:Bind StatusGlyph}"
                ToolTipService.ToolTip="{x:Bind StatusKind}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind Name}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Duration}" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    <InfoBar
        Grid.Row="1"
        Margin="24,0"
        VerticalAlignment="Top"
        IsClosable="False"
        IsOpen="{x:Bind xaml:Bind.IsNotEmpty(ViewModel.ErrorMessage), Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Error" />
  </Grid>
</Page>
