<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Linked.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Linked">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="Linked" />

    <NavigationView
        x:Name="Navigation"
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Icon="Home" Tag="home" />
        <NavigationViewItem Content="Messaging" Icon="Message" Tag="messaging" />
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Margin="12,8" Spacing="8">
          <TextBlock
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
              TextTrimming="CharacterEllipsis" />
          <Button
              Command="{x:Bind ViewModel.SignInCommand}"
              Content="Sign in"
              Style="{StaticResource AccentButtonStyle}"
              Visibility="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}" />
          <Button
              Command="{x:Bind ViewModel.SignOutCommand}"
              Content="Sign out"
              Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
        </StackPanel>
      </NavigationView.PaneFooter>

      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
