<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure HTTP + JSON. No UI, no WinRT, no Windows TFM: builds and tests on any OS. -->
  <PropertyGroup>
    <TargetFramework>$(GuitNetVersion)</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Guit.Api.Tests" />
  </ItemGroup>
</Project>
